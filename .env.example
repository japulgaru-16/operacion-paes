# ==============================================================
# OPERACIÓN PAES: Desactiva la Bomba — Variables de entorno
# ==============================================================
# PASO 1: copia este archivo como ".env" (sin "example").
# PASO 2 (desarrollo local): deja la línea de SQLite tal cual.
# PASO 3 (producción en Vercel): NO subas este archivo a GitHub.
#   En Vercel se configura en: Settings -> Environment Variables,
#   con el nombre DATABASE_URL y la URL de Neon Postgres.

# --- Desarrollo local (SQLite, no requiere internet ni claves) ---
DATABASE_URL=file:../db/custom.db

# --- Producción en Vercel (NO pongas esto en el archivo, va en el dashboard) ---
# DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@EP-XXXX.NEON.TECH/NEONDB?SSLMODE=REQUIRE
